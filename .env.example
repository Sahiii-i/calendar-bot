# Telegram — from @BotFather (README step 1)
TELEGRAM_BOT_TOKEN=
# Your personal chat id — message the bot /start once and it tells you this
TELEGRAM_CHAT_ID=

# Anthropic — https://console.anthropic.com (README step 3)
ANTHROPIC_API_KEY=
# Cheap + fast parsing model. Swap to claude-opus-4-8 for smarter parsing at higher cost.
ANTHROPIC_MODEL=claude-haiku-4-5

# Google OAuth — from Google Cloud console (README step 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated by: npm run get-token
GOOGLE_REFRESH_TOKEN=

TIMEZONE=Asia/Singapore
# Nightly digest of tomorrow's schedule (24h clock, local time)
DIGEST_HOUR=21
DIGEST_MINUTE=0
# How often to scan Gmail for appointment emails
EMAIL_POLL_MINUTES=10
